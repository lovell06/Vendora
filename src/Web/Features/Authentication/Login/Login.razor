@page "/login"
@page "/dang-nhap"
@layout AuthLayout
@inject GatewayClient Gateway
@inject UserSession Session
@inject NavigationManager Navigation
<PageTitle>@L["Sign in"] | Vendora</PageTitle>
<PageHeading Title="@L["Sign in"]" Eyebrow="@L["VENDORA ACCOUNT"]" />
<EditForm Model="_model" OnValidSubmit="Submit" FormName="login" aria-busy="@_busy">
    <DataAnnotationsValidator />
    <AppTextField Id="email" Label="@L["Email address"]" Type="email" @bind-Value="_model.Email" Autocomplete="username" />
    <AppTextField Id="password" Label="@L["Password"]" @bind-Value="_model.Password" Autocomplete="current-password" RevealPassword="true" />
    @if (_error is not null)
    {
        <InlineFeedback Message="@_error" Success="false"></InlineFeedback>
    }
    <AppButton Type="submit" Busy="@_busy" BusyText="@L["Signing in…"]" Class="auth-submit">@L["Sign in"]</AppButton>
</EditForm>
<div class="switch-form">@L["Don’t have an account?"] <a href="/register">@L["Create account"]</a></div>
@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private string? _error;
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.IsAuthenticated) Navigation.NavigateTo(Destination(), replace: true);
    }

    private string Destination() => IsLocal(ReturnUrl) ? ReturnUrl! : Session.IsStaff ? "/admin" : "/";

    private async Task Submit()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Gateway.LoginAsync(_model.Email, _model.Password);
            if (!result.Ok || result.Value is null)
            {
                _error = result.Unauthorized ? L["Incorrect email or password. Please try again."] : result.Error;
                return;
            }
            await Session.SignInAsync(result.Value);
            Navigation.NavigateTo(Destination());
        }
        finally { _busy = false; }
    }
    // Only follow return URLs that stay on this site.
    private static bool IsLocal(string? url) =>
        !string.IsNullOrEmpty(url) && url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));
    private sealed class LoginModel {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EnterEmail)), EmailAddress(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.InvalidEmail))] public string Email { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EnterPassword))] public string Password { get; set; } = "";
    }
}
