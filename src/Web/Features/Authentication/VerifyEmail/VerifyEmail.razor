@page "/verify-email"
@layout AuthLayout
@inject GatewayClient Gateway
<PageTitle>@L["Verify email"] | Vendora</PageTitle>
<PageHeading Title="@L["Verify your email"]" Eyebrow="@L["VENDORA ACCOUNT"]" />
@if (!HasValidLink)
{
    <InlineFeedback Message="@L["This verification link is invalid."]" Success="false">
        <a href="/register">@L["Create an account"]</a>
    </InlineFeedback>
}
else if (_verified)
{
    <InlineFeedback Message="@L["Your email is verified. You can now sign in."]" Success="true" />
    <AppButton OnClick="@(() => Navigation.NavigateTo("/login"))" Class="auth-submit">@L["Sign in"]</AppButton>
}
else
{
    <p class="verify-email-text">@L["Press the button below to confirm this email address for your Vendora account."]</p>
    @if (_error is not null)
    {
        <InlineFeedback Message="@_error" Success="false" />
    }
    <AppButton OnClick="Verify" Busy="@_busy" BusyText="@L["Verifying…"]" Class="auth-submit">@L["Verify email"]</AppButton>
}
<div class="switch-form">@L["Already verified?"] <a href="/login">@L["Sign in"]</a></div>
@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [Parameter, SupplyParameterFromQuery(Name = "userId")] public string? UserId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private bool _busy;
    private bool _verified;
    private string? _error;

    private bool HasValidLink =>
        Guid.TryParse(UserId, out var id) && id != Guid.Empty && !string.IsNullOrWhiteSpace(Token);

    // The API is called only when the user presses the button, never on page load:
    // mail scanners open links in emails, and the token can only be used once.
    private async Task Verify()
    {
        if (_busy || !HasValidLink) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Gateway.VerifyEmailAsync(Guid.Parse(UserId!), Token!.Trim());
            if (result.Ok)
            {
                _verified = true;
                return;
            }
            // The verify API answers an invalid or expired token with an empty 401.
            _error = result.Unauthorized
                ? L["This verification link is invalid or has expired. Verification links are valid for a few minutes."]
                : result.Error;
        }
        finally { _busy = false; }
    }
}
