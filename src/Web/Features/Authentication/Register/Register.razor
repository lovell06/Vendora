@page "/register"
@page "/dang-ky"
@layout AuthLayout
@inject GatewayClient Gateway
@inject UserSession Session
@inject NavigationManager Navigation
<PageTitle>@L["Create account"] | Vendora</PageTitle>
<PageHeading Title="@L["Create account"]" Eyebrow="@L["VENDORA ACCOUNT"]" />
<EditForm Model="_model" OnValidSubmit="Submit" FormName="register" aria-busy="@_busy">
    <DataAnnotationsValidator />
    <AppTextField Id="name" Label="@L["Full name"]" @bind-Value="_model.FullName" Autocomplete="name" />
    <AppTextField Id="email" Label="@L["Email address"]" Type="email" @bind-Value="_model.Email" Autocomplete="username" />
    <AppTextField Id="phone" Label="@L["Phone number"]" Type="tel" @bind-Value="_model.PhoneNumber" Autocomplete="tel" />
    <AppTextField Id="password" Label="@L["Password"]" @bind-Value="_model.Password" Autocomplete="new-password" RevealPassword="true" Hint="@L["Use at least 8 characters."]" />
    <AppTextField Id="confirmation" Label="@L["Confirm password"]" Type="password" @bind-Value="_model.Confirmation" Autocomplete="new-password" />
    @if (_message is not null)
    {
        <InlineFeedback Message="@_message" Success="@_success">
            @if (_success) { <a href="/login">@L["Sign in"]</a> }
        </InlineFeedback>
    }
    <AppButton Type="submit" Busy="@_busy" BusyText="@L["Creating account…"]" Class="auth-submit">@L["Create account"]</AppButton>
</EditForm>
<div class="switch-form">@L["Already have an account?"] <a href="/login">@L["Sign in"]</a></div>
@code {
    private readonly RegisterModel _model = new();
    private bool _busy;
    private string? _message;
    private bool _success;
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (Session.IsAuthenticated) Navigation.NavigateTo(Session.IsStaff ? "/admin" : "/", replace: true);
    }

    private async Task Submit()
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        try
        {
            var result = await Gateway.RegisterAsync(_model.FullName, _model.Email, _model.Password, _model.PhoneNumber);
            _success = result.Ok;
            _message = result.Ok
                ? L["Account created. Check your email for a verification link, then sign in."]
                : result.Status == System.Net.HttpStatusCode.Conflict
                    ? L["This email is already in use. Sign in or use another email."]
                    : result.Error;
        }
        finally { _busy = false; }
    }
    private sealed class RegisterModel {
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EnterFullName)), StringLength(100, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.FullNameTooLong))] public string FullName { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EnterEmail)), EmailAddress(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.InvalidEmail))] public string Email { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.EnterPhone)), Phone(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.InvalidPhone))] public string PhoneNumber { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.CreatePassword)), MinLength(8, ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordTooShort))] public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.ConfirmPassword)), Compare(nameof(Password), ErrorMessageResourceType = typeof(ValidationText), ErrorMessageResourceName = nameof(ValidationText.PasswordsDoNotMatch))] public string Confirmation { get; set; } = "";
    }
}
