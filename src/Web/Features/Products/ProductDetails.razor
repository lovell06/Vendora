@page "/products/{Id}"
@layout HomeLayout
@using Vendora.Web.Features.Home
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrowserViewportService Viewport
@inject GatewayClient Gateway
@inject UserSession Session
@inject CartState Cart
@inject NavigationManager Navigation

<PageTitle>@(_product is null ? (_loading ? L["Loading product"] : L["Product not found"]) : _product.Name) | Vendora</PageTitle>

<StoreHeader />

<main id="home-content" class="product-detail-page" tabindex="-1">
    @if (_loading)
    {
        <div role="status" class="product-detail-skeleton">
            <div class="skeleton-media skeleton-shimmer"></div>
            <div class="skeleton-info">
                <div class="skeleton-line skeleton-line--sm skeleton-shimmer"></div>
                <div class="skeleton-line skeleton-line--lg skeleton-shimmer"></div>
                <div class="skeleton-line skeleton-line--md skeleton-shimmer"></div>
                <div class="skeleton-line skeleton-line--full skeleton-shimmer"></div>
                <div class="skeleton-line skeleton-line--btn skeleton-shimmer"></div>
            </div>
        </div>
    }
    else if (_product is null && _notFound)
    {
        <StatusPage Code="404" Title="@L["Product not found"]" Description="@L["This product is unavailable or may have been removed. Return home to explore other products."]" Icon="@Icons.Material.Outlined.SearchOff" MinimalOnMobile="true" />
    }
    else if (_product is null)
    {
        <StatusPage Code="503" Title="@L["We couldn’t load this product"]" Description="@(_error ?? L["Please try again in a moment."])" Icon="@Icons.Material.Outlined.CloudOff" MinimalOnMobile="true" />
    }
    else
    {
        <!-- Back Navigation -->
        <div class="detail-top-nav">
            <a href="/" class="back-link">
                <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
                <span>@L["All products"]</span>
            </a>
            <span class="detail-nav-cat">/ @_product.Category.Name</span>
        </div>

        <div class="detail-layout">
            <!-- Media Gallery -->
            <div class="detail-media">
                <ProductGallery @key="Id" Images="VisibleImages" @bind-ActiveImageId="_activeImageId" />
                @if (_product.Variants.Count > 0 && _gallery.Count > VisibleImages.Count)
                {
                    <label class="gallery-toggle">
                        <input type="checkbox" @bind="_showAllImages" />
                        <span>@L["All photos ({0})", _gallery.Count]</span>
                    </label>
                }
            </div>

            <!-- Product Information & Purchase -->
            <section class="detail-summary" aria-labelledby="product-title">
                <p class="category-eyebrow">@_product.Category.Name</p>
                <h1 id="product-title" class="product-title">@_product.Name</h1>

                <div class="price-stock-row">
                    <span class="detail-price">@PriceText</span>
                    <span class="stock-status @(CanPurchase ? "stock-status--in" : "stock-status--out")">
                        @(CanPurchase ? L["In stock"] : L["Out of stock"])
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <p class="description">@_product.Description</p>
                }

                @if (_variants.Count > 0)
                {
                    <fieldset class="variant-selector">
                        <legend>@L["Option:"] <span class="selected-variant-name">@_selectedVariant?.Name</span></legend>
                        <div class="variant-options">
                            @foreach (var variant in _variants)
                            {
                                var thumbnail = _gallery.FirstOrDefault(image => image.Id == variant.PrimaryImageId);
                                var isSelected = variant.Id == _selectedVariant?.Id;
                                <button type="button" class="variant-chip @(isSelected ? "variant-chip--selected" : "")"
                                        aria-pressed="@(isSelected ? "true" : "false")"
                                        @onclick="() => SelectVariant(variant)">
                                    @if (thumbnail is not null)
                                    {
                                        <img src="@thumbnail.Url" alt="" width="32" height="32" loading="lazy" />
                                    }
                                    <span class="variant-chip-label">@variant.Name</span>
                                    @if (!variant.InStock)
                                    {
                                        <small class="variant-chip-out">@L["(Out)"]</small>
                                    }
                                </button>
                            }
                        </div>
                    </fieldset>
                }

                @if (Session.IsStaff)
                {
                    <div class="purchase-controls">
                        <MudButton Href="@($"/admin/products/{Id}")" Variant="Variant.Outlined" Color="Color.Primary" Class="app-button"
                                   StartIcon="@Icons.Material.Outlined.AdminPanelSettings">@(Session.Current?.Role == "Admin" ? L["Edit in admin"] : L["View in admin"])</MudButton>
                    </div>
                }
                else
                {
                <div class="purchase-controls">
                    <div class="quantity-col">
                        <QuantitySelector @bind-Value="_quantity" Min="1" Max="99" Disabled="@(!CanPurchase)" />
                    </div>
                    <AppButton OnClick="RequestAddToCart" Busy="@_adding" BusyText="@L["Adding…"]" Disabled="@(!CanPurchase || _openingSheet || _quantity < 1 || _quantity > 99)" Class="detail-add-btn">
                        <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Small" />
                        <span>@(CanPurchase ? L["Add to cart"] : L["Out of stock"])</span>
                    </AppButton>
                </div>
                }

                <!-- Desktop-only trust features -->
                <div class="desktop-perks">
                    <div class="perk-item">
                        <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Size="Size.Small" />
                        <span>@L["Free express delivery on orders over 500k"]</span>
                    </div>
                    <div class="perk-item">
                        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Size="Size.Small" />
                        <span>@L["100% genuine with official warranty"]</span>
                    </div>
                    <div class="perk-item">
                        <MudIcon Icon="@Icons.Material.Outlined.PublishedWithChanges" Size="Size.Small" />
                        <span>@L["30-day hassle-free returns"]</span>
                    </div>
                </div>

                <!-- Product Specifications -->
                <section class="product-information" aria-labelledby="information-title">
                    <h2 id="information-title">@L["Product information"]</h2>
                    <dl class="specs-list">
                        <div><dt>@L["Category"]</dt><dd>@_product.Category.Name</dd></div>
                        <div><dt>@L["Brand"]</dt><dd>@_product.Brand</dd></div>
                        <div><dt>@L["Product code"]</dt><dd>@(_selectedVariant?.ProductCode ?? _product.Id.ToString())</dd></div>
                    </dl>
                </section>
            </section>
        </div>

        @if (_related.Count > 0)
        {
            <section class="related-section" aria-labelledby="related-title">
                <h2 id="related-title">@L["You may also like"]</h2>
                <ProductGrid>
                    @foreach (var product in _related)
                    {
                        <ProductCard @key="product.Id" Name="@product.Name" Category="@_product.Category.Name"
                                     PriceText="@PriceFormatter.FormatRange(product.MinPrice, product.MaxPrice, product.Currency)"
                                     ImageUrl="@product.ImageUrl" DetailsHref="@($"/products/{product.Id}")" />
                    }
                </ProductGrid>
            </section>
        }
    }
</main>

@code {
    [Parameter] public string Id { get; set; } = "";
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private ProductDetailDto? _product;
    private IReadOnlyList<ProductImage> _gallery = [];
    private IReadOnlyList<ProductVariant> _variants = [];
    private readonly Dictionary<string, decimal> _prices = [];
    private IReadOnlyList<ProductSummaryDto> _related = [];
    private bool _loading;
    private bool _notFound;
    private string? _error;
    private int _quantity = 1;
    private bool _openingSheet;
    private bool _adding;
    private ProductVariant? _selectedVariant;
    private string? _activeImageId;
    private bool _showAllImages;
    private string? _loadedId;

    private bool CanPurchase => _product is not null && (_selectedVariant?.InStock ?? false);
    private string PriceText => _product is null ? "" :
        _selectedVariant is not null && _prices.TryGetValue(_selectedVariant.Id, out var price)
            ? PriceFormatter.Format(price, _product.Currency)
            : _product.Variants.Count == 0 ? "" :
              PriceFormatter.FormatRange(_product.Variants.Min(v => v.Price), _product.Variants.Max(v => v.Price), _product.Currency);
    private IReadOnlyList<ProductImage> VisibleImages
    {
        get
        {
            if (_showAllImages || _selectedVariant is null) return _gallery;
            var own = _gallery.Where(image => _selectedVariant.ImageIds.Contains(image.Id)).ToArray();
            return own.Length > 0 ? own : _gallery;
        }
    }
    private ProductImage? RepresentativeImage => _gallery.FirstOrDefault(image =>
        image.Id == _selectedVariant?.PrimaryImageId) ?? _gallery.FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnStateChanged;
        Cart.Changed += OnStateChanged;
        await Session.EnsureLoadedAsync();
        if (Session.IsAuthenticated) _ = Cart.RefreshAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        _product = null;
        _related = [];
        _quantity = 1;
        _showAllImages = false;
        try
        {
            if (!long.TryParse(Id, out var productId)) { _notFound = true; return; }

            var result = await Gateway.GetProductAsync(productId);
            if (_loadedId != Id) return;
            if (!result.Ok || result.Value is null)
            {
                _notFound = result.NotFound;
                _error = result.Error;
                return;
            }

            _product = result.Value;
            var product = _product;
            _gallery = product.Images.OrderBy(image => image.SortOrder)
                .Select((image, index) => new ProductImage(image.Id.ToString(), image.Url, L["{0} · photo {1}", product.Name, index + 1]))
                .ToList();
            _prices.Clear();
            foreach (var variant in product.Variants) _prices[variant.Id.ToString()] = variant.Price;
            _variants = product.Variants.Select(variant =>
            {
                var imageIds = variant.ImageIds.Select(imageId => imageId.ToString()).ToList();
                var primary = imageIds.FirstOrDefault() ?? _gallery.FirstOrDefault()?.Id ?? "";
                return new ProductVariant(variant.Id.ToString(), variant.Name, variant.Sku, imageIds, primary, variant.InStock);
            }).ToList();
            _selectedVariant = _variants.FirstOrDefault(variant => variant.InStock) ?? _variants.FirstOrDefault();
            _activeImageId = RepresentativeImage?.Id;
        }
        finally
        {
            _loading = false;
            if (_product is null && _notFound && HttpContext is { Response.HasStarted: false })
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }

        if (_product is not null) _ = LoadRelatedAsync(_product);
    }

    private async Task LoadRelatedAsync(ProductDetailDto product)
    {
        var result = await Gateway.ListProductsAsync(product.Category.Id, null, 1, 5);
        if (_product?.Id != product.Id || !result.Ok || result.Value is null) return;
        _related = result.Value.Products.Where(item => item.Id != product.Id).Take(4).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectVariant(ProductVariant variant)
    {
        _selectedVariant = variant;
        _activeImageId = variant.PrimaryImageId;
        _showAllImages = false;
        _quantity = 1;
    }

    private async Task RequestAddToCart()
    {
        if (_product is null || !CanPurchase || _openingSheet) return;
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString($"/products/{Id}")}");
            return;
        }
        _openingSheet = true;
        var productId = Id;
        var variantId = _selectedVariant?.Id;
        try
        {
            if (!await Viewport.IsMediaQueryMatchAsync("(max-width: 599px)"))
            {
                await AddToCartAsync();
                return;
            }
            var parameters = new DialogParameters<AddToCartSheet>
            {
                { sheet => sheet.Name, _product.Name },
                { sheet => sheet.ImageUrl, RepresentativeImage?.Url },
                { sheet => sheet.VariantName, _selectedVariant?.Name },
                { sheet => sheet.PriceText, PriceText },
                { sheet => sheet.InitialQuantity, _quantity }
            };
            var options = new DialogOptions
            {
                Position = DialogPosition.BottomCenter, FullWidth = true, MaxWidth = MaxWidth.False,
                NoHeader = true, BackdropClick = true, CloseOnEscapeKey = true,
                CloseOnNavigation = true, BackgroundClass = "cart-sheet-backdrop"
            };
            var dialog = await DialogService.ShowAsync<AddToCartSheet>(L["Add to cart"], parameters, options);
            var result = await dialog.Result;
            if (Id == productId && _selectedVariant?.Id == variantId && result is { Canceled: false, Data: int quantity })
            {
                _quantity = quantity;
                await AddToCartAsync();
            }
        }
        finally { _openingSheet = false; }
    }

    private async Task AddToCartAsync()
    {
        if (_product is null || !CanPurchase || _selectedVariant is null || _quantity is < 1 or > 99 || _adding) return;
        _adding = true;
        try
        {
            var result = await Cart.AddAsync(long.Parse(_selectedVariant.Id), _quantity);
            if (result.Ok)
                Snackbar.Add($"{_quantity} × {_product.Name} added to your cart.", Severity.Success);
            else
                Snackbar.Add(result.Error ?? L["Unable to add this product."], Severity.Error);
        }
        finally { _adding = false; }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnStateChanged;
        Cart.Changed -= OnStateChanged;
    }
}
