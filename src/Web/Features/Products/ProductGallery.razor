<section class="product-gallery" aria-label="@L["Product gallery"]">
    <div class="gallery-main-card">
        <div class="gallery-image">
            @if (ActiveImage is { } image && !_failedUrls.Contains(image.Url))
            {
                <img @key="image.Url" src="@image.Url" alt="@image.Alt" width="600" height="600"
                     fetchpriority="high" @onerror="() => _failedUrls.Add(image.Url)" class="gallery-img-active" />
            }
            else
            {
                <div class="gallery-fallback">
                    <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" Size="Size.Large" aria-hidden="true" />
                    <span>@L["Image unavailable"]</span>
                </div>
            }
        </div>
        <div class="gallery-counter-pill" aria-live="polite" aria-atomic="true">
            @(ActiveIndex + 1) / @Images.Count
        </div>
    </div>
    @if (Images.Count > 1)
    {
        <div class="gallery-thumbnails" role="group" aria-label="@L["Choose product image"]">
            @foreach (var thumbnail in Images)
            {
                var isSelected = thumbnail.Id == ActiveImage?.Id;
                <button @key="thumbnail.Id" type="button" class="gallery-thumbnail @(isSelected ? "gallery-thumbnail--selected" : "")"
                        aria-label="@L["View {0}", thumbnail.Alt]" aria-pressed="@(isSelected ? "true" : "false")"
                        @onclick="() => ActiveImageIdChanged.InvokeAsync(thumbnail.Id)">
                    @if (!_failedUrls.Contains(thumbnail.Url))
                    {
                        <img src="@thumbnail.Url" alt="" width="72" height="72" loading="lazy" @onerror="() => _failedUrls.Add(thumbnail.Url)" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.ImageNotSupported" Size="Size.Small" aria-hidden="true" />
                    }
                </button>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ProductImage> Images { get; set; } = [];
    [Parameter] public string? ActiveImageId { get; set; }
    [Parameter] public EventCallback<string> ActiveImageIdChanged { get; set; }
    private readonly HashSet<string> _failedUrls = [];
    private ProductImage? ActiveImage => Images.FirstOrDefault(image => image.Id == ActiveImageId) ?? Images.FirstOrDefault();
    private int ActiveIndex => Images.ToList().FindIndex(image => image.Id == ActiveImage?.Id);
}
