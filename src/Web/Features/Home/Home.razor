@page "/"
@page "/home"
@layout HomeLayout
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrowserViewportService Viewport
@inject GatewayClient Gateway
@inject UserSession Session
@inject CartState Cart
@inject CartUiState CartUi
@inject NavigationManager Navigation
<PageTitle>@L["Home"] | Vendora</PageTitle>

<StoreHeader />

<main id="home-content" class="store-content" tabindex="-1">
    <!-- Desktop-only clean hero section; hidden on mobile to prioritize products directly -->
    <section class="desktop-hero" aria-label="@L["Catalog intro"]">
        <div class="hero-text">
            <h1 class="hero-title">@L["Discover Curated Essentials"]</h1>
            <p class="hero-subtitle">@L["Quality products, transparent pricing, and seamless checkout."]</p>
        </div>
    </section>

    <!-- Toolbar: Search + Category MudChips in Horizontal Streamlined Layout -->
    <div class="catalog-toolbar">
        <form class="store-search" @onsubmit="Search" @onsubmit:preventDefault role="search">
            <MudTextField T="string" InputId="product-search" @bind-Value="_query" InputType="InputType.Search"
                          Placeholder="@L["Search products…"]" Variant="Variant.Text" Underline="false"
                          Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Margin="Margin.Dense" Class="catalog-search-input" aria-label="@L["Search products"]" />
            @if (!string.IsNullOrWhiteSpace(_query))
            {
                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="ClearSearch" aria-label="@L["Clear search"]" Class="search-clear-btn" />
            }
            <AppButton Type="submit" Class="search-submit-btn">@L["Search"]</AppButton>
        </form>

        <!-- Category Buttons: Original MudChipSet appearance inside streamlined toolbar -->
        <div class="category-options" aria-label="@L["Product categories"]">
            <MudChipSet T="string" SelectedValue="_selectedCategory" SelectedValueChanged="OnCategoryChanged"
                        SelectionMode="SelectionMode.SingleSelection" CheckMark="true" Size="Size.Small"
                        Label="true" aria-label="@L["Product category"]">
                <MudChip T="string" Value="@("all")">@L["All products"]</MudChip>
                @foreach (var category in _categories)
                {
                    <MudChip T="string" Value="@category.Id.ToString()">@category.Name</MudChip>
                }
            </MudChipSet>
        </div>
    </div>

    <!-- Results Section (Full Width, Streamlined Layout) -->
    <section class="catalog-results" aria-labelledby="products-title">
        <div class="results-header">
            <h2 id="products-title" class="results-title">@(_submittedQuery.Length == 0 ? (SelectedCategoryName ?? L["All products"]) : L["Search: “{0}”", _submittedQuery])</h2>
            <span class="product-count" aria-live="polite">@(_totalCount == 1 ? L["1 item"] : L["{0} items", _totalCount])</span>
        </div>
        @if (_submittedQuery.Length > 0)
        {
            <div class="search-summary">
                <span>@L["Results for “{0}”", _submittedQuery]</span>
                <AppButton Variant="ButtonVariant.Text" OnClick="ClearSearch">@L["Clear search"]</AppButton>
            </div>
        }

        @if (_loading && _products.Count == 0)
        {
            <ProductGrid>
                @for (var i = 0; i < 8; i++)
                {
                    <ProductCardSkeleton @key="i" />
                }
            </ProductGrid>
        }
        else if (_error is not null)
        {
            <div class="catalog-empty" role="alert">
                <h3>@L["We couldn’t load products"]</h3>
                <p>@_error</p>
                <AppButton Variant="ButtonVariant.Primary" OnClick="Reload">@L["Try again"]</AppButton>
            </div>
        }
        else if (_products.Count > 0)
        {
            <ProductGrid>
                @foreach (var product in _products)
                {
                    <ProductCard @key="product.Id" Name="@product.Name" Category="@SelectedCategoryName"
                                 PriceText="@PriceFormatter.FormatRange(product.MinPrice, product.MaxPrice, product.Currency)"
                                 ImageUrl="@product.ImageUrl" DetailsHref="@($"/products/{product.Id}")"
                                 Busy="@(_busyProductId == product.Id)" OnAddToCart="@(Session.IsStaff ? default : EventCallback.Factory.Create<MouseEventArgs>(this, () => AddToCart(product)))" />
                }
            </ProductGrid>
            @if (_products.Count < _totalCount)
            {
                <div class="load-more">
                    <AppButton Variant="ButtonVariant.Text" OnClick="LoadMore" Busy="@_loading" BusyText="@L["Loading…"]" Class="load-more-btn">
                        @L["Load more ({0} remaining)", _totalCount - _products.Count]
                    </AppButton>
                </div>
            }
        }
        else
        {
            <div class="catalog-empty">
                <h3>@L["No products found"]</h3>
                <p>@L["Try another search or category."]</p>
                <AppButton Variant="ButtonVariant.Text" OnClick="ResetFilters">@L["Reset filters"]</AppButton>
            </div>
        }
    </section>
</main>

@code {
    private const int PageSize = 24;

    [Parameter, SupplyParameterFromQuery(Name = "panel")] public string? Panel { get; set; }

    private IReadOnlyList<CategoryDto> _categories = [];
    private readonly List<ProductSummaryDto> _products = [];
    private int _totalCount;
    private int _page;
    private bool _loading;
    private string? _error;
    private long? _busyProductId;
    private string _selectedCategory = "all";
    private string _query = "";
    private string _submittedQuery = "";

    private int? SelectedCategoryId => int.TryParse(_selectedCategory, out var id) ? id : null;
    private string? SelectedCategoryName => _categories.FirstOrDefault(category => category.Id == SelectedCategoryId)?.Name;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.EnsureLoadedAsync();

        var categories = await Gateway.ListCategoriesAsync();
        if (categories.Ok && categories.Value is not null) _categories = categories.Value.Categories;

        var loadProducts = LoadProductsAsync(reset: true);
        if (Session.IsAuthenticated)
        {
            await Cart.RefreshAsync();
        }
        await loadProducts;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Panel == "cart" && Session.IsAuthenticated) await CartUi.OpenAsync();
    }

    private async Task LoadProductsAsync(bool reset)
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        try
        {
            var page = reset ? 1 : _page + 1;
            var result = await Gateway.ListProductsAsync(SelectedCategoryId, _submittedQuery, page, PageSize);
            if (!result.Ok || result.Value is null)
            {
                if (reset) { _products.Clear(); _totalCount = 0; }
                _error = result.Error;
                return;
            }
            if (reset) _products.Clear();
            _products.AddRange(result.Value.Products);
            _totalCount = result.Value.TotalCount;
            _page = page;
        }
        finally { _loading = false; }
    }

    private Task Reload() => LoadProductsAsync(reset: true);
    private Task LoadMore() => LoadProductsAsync(reset: false);

    private async Task OnCategoryChanged(string? value)
    {
        _selectedCategory = string.IsNullOrEmpty(value) ? "all" : value;
        await LoadProductsAsync(reset: true);
    }

    private async Task Search()
    {
        _submittedQuery = _query.Trim();
        await LoadProductsAsync(reset: true);
    }

    private async Task ClearSearch()
    {
        _query = "";
        _submittedQuery = "";
        await LoadProductsAsync(reset: true);
    }

    private async Task ResetFilters()
    {
        _selectedCategory = "all";
        await ClearSearch();
    }

    private async Task AddToCart(ProductSummaryDto summary)
    {
        if (_busyProductId is not null) return;
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/")}");
            return;
        }
        _busyProductId = summary.Id;
        try
        {
            var detail = await Gateway.GetProductAsync(summary.Id);
            if (!detail.Ok || detail.Value is null)
            {
                Snackbar.Add(detail.Error ?? L["Unable to add this product."], Severity.Error);
                return;
            }
            var variants = detail.Value.Variants;
            if (variants.Count != 1)
            {
                Snackbar.Add(L["Choose an option for this product first."], Severity.Info);
                Navigation.NavigateTo($"/products/{summary.Id}");
                return;
            }
            var variant = variants[0];
            if (!variant.InStock)
            {
                Snackbar.Add(L["This product is out of stock."], Severity.Warning);
                return;
            }

            var quantity = 1;
            if (await Viewport.GetCurrentBreakpointAsync() == Breakpoint.Xs)
            {
                var parameters = new DialogParameters<AddToCartSheet>
                {
                    { sheet => sheet.Name, summary.Name },
                    { sheet => sheet.ImageUrl, summary.ImageUrl },
                    { sheet => sheet.PriceText, PriceFormatter.Format(variant.Price, summary.Currency) }
                };
                var options = new DialogOptions
                {
                    Position = DialogPosition.BottomCenter, FullWidth = true, MaxWidth = MaxWidth.False,
                    NoHeader = true, BackdropClick = true, CloseOnEscapeKey = true,
                    CloseOnNavigation = true, BackgroundClass = "cart-sheet-backdrop"
                };
                var dialog = await DialogService.ShowAsync<AddToCartSheet>(L["Add to cart"], parameters, options);
                var result = await dialog.Result;
                if (result is not { Canceled: false, Data: int selected }) return;
                quantity = selected;
            }

            var added = await Cart.AddAsync(variant.Id, quantity);
            if (added.Ok) Snackbar.Add($"{quantity} × {summary.Name} added to your cart.", Severity.Success);
            else Snackbar.Add(added.Error ?? L["Unable to add this product."], Severity.Error);
        }
        finally { _busyProductId = null; }
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
