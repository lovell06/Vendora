@page "/"
@page "/home"
@layout HomeLayout
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrowserViewportService Viewport
@inject GatewayClient Gateway
@inject UserSession Session
@inject CartState Cart
@inject CartUiState CartUi
@inject NavigationManager Navigation
<PageTitle>Home | Vendora</PageTitle>
<StoreHeader>
        @if (Session.IsAuthenticated)
        {
            <CartButton />
            <AppButton Variant="ButtonVariant.Icon" OnClick="ToggleAccount" aria-label="Your account" aria-expanded="@_accountOpen" aria-controls="account-panel"><AppIcon Name="user" /><span class="desktop-action-label">Account</span></AppButton>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="app-button sign-in-link">Sign in</MudButton>
        }
</StoreHeader>
<main id="home-content" class="store-content" tabindex="-1">
    <div class="catalog-intro"><PageHeading Title="Explore products" Eyebrow="CATALOG" /></div>
    @if (Session.IsAuthenticated && _accountOpen)
    {
        <section id="account-panel" class="cart-panel" aria-labelledby="account-title">
            <div class="section-heading"><h2 id="account-title">Your account</h2><AppButton Variant="ButtonVariant.Text" OnClick="ToggleAccount">Close</AppButton></div>
            <p>@Session.DisplayName</p>
            <AppButton Variant="ButtonVariant.Text" OnClick="SignOut" Busy="@_signingOut" BusyText="Signing out…">Sign out</AppButton>
        </section>
    }
    <form class="store-search" @onsubmit="Search" @onsubmit:preventDefault role="search">
        <MudTextField T="string" InputId="product-search" @bind-Value="_query" InputType="InputType.Search" Placeholder="Search products" Variant="Variant.Text" Underline="false" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Margin="Margin.Dense" Class="catalog-search-input" aria-label="Search products" />
        <AppButton Type="submit">Search</AppButton>
    </form>
    <div class="catalog-layout">
        <aside class="catalog-filters" aria-labelledby="category-title">
            <h2 id="category-title">Categories</h2>
            <div class="category-options">
                <MudChipSet T="string" SelectedValue="_selectedCategory" SelectedValueChanged="OnCategoryChanged" SelectionMode="SelectionMode.SingleSelection" CheckMark="true" Size="Size.Small" Label="true" aria-label="Product category">
                    <MudChip T="string" Value="@("all")">All products</MudChip>
                    @foreach (var category in _categories)
                    {
                        <MudChip T="string" Value="@category.Id.ToString()">@category.Name</MudChip>
                    }
                </MudChipSet>
            </div>
        </aside>
        <section class="catalog-results" aria-labelledby="products-title">
            <div class="section-heading results-heading"><h2 id="products-title">@(_submittedQuery.Length == 0 ? "All products" : "Search results")</h2><span class="product-count" aria-live="polite">@_totalCount products</span></div>
            @if (_submittedQuery.Length > 0)
            {
                <div class="search-summary"><span>Results for “@_submittedQuery”</span><AppButton Variant="ButtonVariant.Text" OnClick="ClearSearch">Clear search</AppButton></div>
            }
            @if (_loading && _products.Count == 0)
            {
                <div class="catalog-empty" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Medium" aria-label="Loading products" /></div>
            }
            else if (_error is not null)
            {
                <div class="catalog-empty" role="alert">
                    <h3>We couldn’t load products</h3>
                    <p>@_error</p>
                    <AppButton Variant="ButtonVariant.Text" OnClick="Reload">Try again</AppButton>
                </div>
            }
            else if (_products.Count > 0)
            {
                <ProductGrid>
                    @foreach (var product in _products)
                    {
                        <ProductCard @key="product.Id" Name="@product.Name" Category="@SelectedCategoryName" PriceText="@PriceFormatter.FormatRange(product.MinPrice, product.MaxPrice, product.Currency)" ImageUrl="@product.ImageUrl" DetailsHref="@($"/products/{product.Id}")" Busy="@(_busyProductId == product.Id)" OnAddToCart="@(() => AddToCart(product))" />
                    }
                </ProductGrid>
                @if (_products.Count < _totalCount)
                {
                    <div class="load-more"><AppButton Variant="ButtonVariant.Text" OnClick="LoadMore" Busy="@_loading" BusyText="Loading…">Load more</AppButton></div>
                }
            }
            else
            {
                <div class="catalog-empty">
                    <h3>No products found</h3>
                    <p>Try another search or category.</p>
                    <AppButton Variant="ButtonVariant.Text" OnClick="ResetFilters">Reset filters</AppButton>
                </div>
            }
        </section>
    </div>
</main>
@code {
    private const int PageSize = 24;

    [Parameter, SupplyParameterFromQuery(Name = "panel")] public string? Panel { get; set; }

    private IReadOnlyList<CategoryDto> _categories = [];
    private readonly List<ProductSummaryDto> _products = [];
    private int _totalCount;
    private int _page;
    private bool _loading;
    private string? _error;
    private long? _busyProductId;
    private bool _signingOut;
    private string _selectedCategory = "all";
    private string _query = "";
    private string _submittedQuery = "";
    private bool _accountOpen;

    private int? SelectedCategoryId => int.TryParse(_selectedCategory, out var id) ? id : null;
    private string? SelectedCategoryName => _categories.FirstOrDefault(category => category.Id == SelectedCategoryId)?.Name;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.EnsureLoadedAsync();

        var categories = await Gateway.ListCategoriesAsync();
        if (categories.Ok && categories.Value is not null) _categories = categories.Value.Categories;

        var loadProducts = LoadProductsAsync(reset: true);
        if (Session.IsAuthenticated)
        {
            await Cart.RefreshAsync();
        }
        await loadProducts;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Old deep link /?panel=cart: floating panel on wide screens, the /cart page on phones.
        if (firstRender && Panel == "cart" && Session.IsAuthenticated) await CartUi.OpenAsync();
    }

    private async Task LoadProductsAsync(bool reset)
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        try
        {
            var page = reset ? 1 : _page + 1;
            var result = await Gateway.ListProductsAsync(SelectedCategoryId, _submittedQuery, page, PageSize);
            if (!result.Ok || result.Value is null)
            {
                if (reset) { _products.Clear(); _totalCount = 0; }
                _error = result.Error;
                return;
            }
            if (reset) _products.Clear();
            _products.AddRange(result.Value.Products);
            _totalCount = result.Value.TotalCount;
            _page = page;
        }
        finally { _loading = false; }
    }

    private Task Reload() => LoadProductsAsync(reset: true);
    private Task LoadMore() => LoadProductsAsync(reset: false);

    private async Task OnCategoryChanged(string? value)
    {
        _selectedCategory = string.IsNullOrEmpty(value) ? "all" : value;
        await LoadProductsAsync(reset: true);
    }

    private async Task Search()
    {
        _submittedQuery = _query.Trim();
        await LoadProductsAsync(reset: true);
    }

    private async Task ClearSearch()
    {
        _query = "";
        _submittedQuery = "";
        await LoadProductsAsync(reset: true);
    }

    private async Task ResetFilters()
    {
        _selectedCategory = "all";
        await ClearSearch();
    }

    private async Task AddToCart(ProductSummaryDto summary)
    {
        if (_busyProductId is not null) return;
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/")}");
            return;
        }
        _busyProductId = summary.Id;
        try
        {
            // The list does not carry variants, so load the product to know what can be added.
            var detail = await Gateway.GetProductAsync(summary.Id);
            if (!detail.Ok || detail.Value is null)
            {
                Snackbar.Add(detail.Error ?? "Unable to add this product.", Severity.Error);
                return;
            }
            var variants = detail.Value.Variants;
            if (variants.Count != 1)
            {
                Snackbar.Add("Choose an option for this product first.", Severity.Info);
                Navigation.NavigateTo($"/products/{summary.Id}");
                return;
            }
            var variant = variants[0];
            if (!variant.InStock)
            {
                Snackbar.Add("This product is out of stock.", Severity.Warning);
                return;
            }

            var quantity = 1;
            if (await Viewport.GetCurrentBreakpointAsync() == Breakpoint.Xs)
            {
                var parameters = new DialogParameters<AddToCartSheet>
                {
                    { sheet => sheet.Name, summary.Name },
                    { sheet => sheet.ImageUrl, summary.ImageUrl },
                    { sheet => sheet.PriceText, PriceFormatter.Format(variant.Price, summary.Currency) }
                };
                var options = new DialogOptions
                {
                    Position = DialogPosition.BottomCenter, FullWidth = true, MaxWidth = MaxWidth.False,
                    NoHeader = true, BackdropClick = true, CloseOnEscapeKey = true,
                    CloseOnNavigation = true, BackgroundClass = "cart-sheet-backdrop"
                };
                var dialog = await DialogService.ShowAsync<AddToCartSheet>("Add to cart", parameters, options);
                var result = await dialog.Result;
                if (result is not { Canceled: false, Data: int selected }) return;
                quantity = selected;
            }

            var added = await Cart.AddAsync(variant.Id, quantity);
            if (added.Ok) Snackbar.Add($"{quantity} × {summary.Name} added to your cart.", Severity.Success);
            else Snackbar.Add(added.Error ?? "Unable to add this product.", Severity.Error);
        }
        finally { _busyProductId = null; }
    }

    private async Task SignOut()
    {
        if (_signingOut) return;
        _signingOut = true;
        try
        {
            await Gateway.LogoutAsync(); // Best effort: the local session ends either way.
            Cart.Clear();
            await Session.SignOutAsync();
            _accountOpen = false;
        }
        finally { _signingOut = false; }
    }

    private void ToggleAccount() { if (!Session.IsAuthenticated) return; _accountOpen = !_accountOpen; }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsAuthenticated) { _accountOpen = false; }
        StateHasChanged();
    });

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
