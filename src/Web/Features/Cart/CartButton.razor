@implements IDisposable
@inject CartState Cart
@inject CartUiState CartUi
@inject ViewportState Viewport

<a href="/cart" @ref="_link" class="cart-button" @onclick="OnClick" @onclick:preventDefault="@(!Viewport.IsCompact)"
   aria-label="@L["Open cart, {0} items", Cart.Count]" aria-haspopup="@(Viewport.IsCompact ? null : "dialog")" aria-expanded="@(Viewport.IsCompact ? null : CartUi.IsDrawerOpen.ToString().ToLowerInvariant())">
    <div class="cart-icon-wrapper">
        <AppIcon Name="bag" />
        @if (Cart.Count > 0)
        {
            <span class="cart-badge" @key="Cart.Count" aria-hidden="true">@(Cart.Count > 99 ? "99+" : Cart.Count.ToString())</span>
        }
    </div>
    <span class="cart-button-label">Cart</span>
</a>

@code {
    private ElementReference _link;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += OnChanged;
        Viewport.Changed += OnChanged;
        await Viewport.EnsureInitializedAsync();
    }

    private async Task OnClick()
    {
        CartUi.Trigger = _link;
        if (Viewport.IsCompact) { CartUi.CameFromInApp = true; return; }
        await CartUi.OpenAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cart.Changed -= OnChanged;
        Viewport.Changed -= OnChanged;
    }
}
