<MudAlert Severity="@(Success ? Severity.Success : Severity.Error)" Variant="Variant.Text" Dense="true" Class="feedback" role="status">
    @Message
    @ChildContent
</MudAlert>
@code {
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public bool Success { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
