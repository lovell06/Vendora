@using Microsoft.AspNetCore.Components.Authorization
<header class="store-header">
    <BrandLink />
    <nav aria-label="Account">
        <ThemePicker />
        <AuthorizeView Roles="Admin,Employee">
            <MudButton Href="/admin" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="app-button">Quản trị</MudButton>
        </AuthorizeView>
        @if (ChildContent is not null) { @ChildContent }
        else { <MudButton Href="/login" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="app-button">Sign in</MudButton> }
    </nav>
</header>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
