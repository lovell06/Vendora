@using Vendora.Web.Components.UI.Buttons

<article class="product-card">
    <div class="product-card-surface">
        <div class="product-image-wrap">
            @if (!string.IsNullOrWhiteSpace(ImageUrl) && !_imageFailed)
            {
                <img src="@ImageUrl" alt="@(ImageAlt ?? Name)" width="480" height="480" loading="lazy" decoding="async" @onerror="() => _imageFailed = true" />
            }
            else
            {
                <div class="image-fallback" role="img" aria-label="@L["Product image unavailable"]"><MudIcon Icon="@Icons.Material.Outlined.Inventory2" aria-hidden="true" /></div>
            }
            @if (InStock == false)
            {
                <span class="stock-badge stock-badge--out">@L["Out of stock"]</span>
            }
        </div>
        <div class="product-content">
            @if (!string.IsNullOrWhiteSpace(Category))
            {
                <p class="product-category">@Category</p>
            }
            <h3 class="product-name">
                @if (!string.IsNullOrWhiteSpace(DetailsHref))
                {
                    <a href="@DetailsHref">@Name</a>
                }
                else
                {
                    @Name
                }
            </h3>
            <div class="product-price-container">
                <p class="product-price">@PriceText</p>
            </div>
        </div>
        @if (OnAddToCart.HasDelegate)
        {
            <div class="product-actions">
                <AppButton Class="product-add-btn" Disabled="@(InStock == false)" Busy="@Busy" BusyText="@L["Adding…"]" OnClick="OnAddToCart" aria-label="@L["Add {0} to cart", Name]">
                    <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Small" />
                    <span>@(InStock == false ? "Out of stock" : "Add to cart")</span>
                </AppButton>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string PriceText { get; set; } = "";
    [Parameter] public string? Category { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public string? DetailsHref { get; set; }
    [Parameter] public bool? InStock { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnAddToCart { get; set; }
    private bool _imageFailed;
    private string? _previousImage;
    protected override void OnParametersSet()
    {
        if (_previousImage == ImageUrl) return;
        _previousImage = ImageUrl;
        _imageFailed = false;
    }
}
