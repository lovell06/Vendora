@page "/Error"
@layout StatusLayout

<PageTitle>@L["Something went wrong"] | Vendora</PageTitle>
<StatusPage Code="500" Title="@L["Something went wrong"]" Description="@L["We couldn’t load this page. Please return home and try again in a moment."]" Icon="@Icons.Material.Outlined.ErrorOutline" />

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is { Response.HasStarted: false })
            HttpContext.Response.StatusCode = StatusCodes.Status500InternalServerError;
    }
}
