@page "/not-found"
@layout StatusLayout

<PageTitle>@L["Page not found"] | Vendora</PageTitle>
<StatusPage MinimalOnMobile="true" Code="404" Title="@L["Page not found"]" Description="@L["This page may have moved or no longer exists. Return home to explore products."]" Icon="@Icons.Material.Outlined.SearchOff" />

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is { Response.HasStarted: false })
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
