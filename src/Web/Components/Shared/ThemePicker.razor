@implements IDisposable
@inject ThemeState ThemeState

<MudMenu Label="@Label" StartIcon="@ThemeIcon" EndIcon="@Icons.Material.Outlined.ExpandMore" AriaLabel="Color theme" Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Dense="true" Class="theme-picker" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <MudMenuItem Icon="@Icons.Material.Outlined.SettingsBrightness" OnClick="@(() => SelectTheme("system"))">System @Selected("system")</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" OnClick="@(() => SelectTheme("light"))">Light @Selected("light")</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" OnClick="@(() => SelectTheme("dark"))">Dark @Selected("dark")</MudMenuItem>
</MudMenu>

@code {
    private string Label => ThemeState.Preference switch { "light" => "Light", "dark" => "Dark", _ => "System" };
    private string ThemeIcon => ThemeState.Preference switch
    {
        "light" => Icons.Material.Outlined.LightMode,
        "dark" => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.SettingsBrightness
    };
    private RenderFragment Selected(string preference) => builder =>
    {
        if (ThemeState.Preference == preference)
        {
            builder.OpenComponent<MudIcon>(0);
            builder.AddAttribute(1, "Icon", Icons.Material.Filled.Check);
            builder.AddAttribute(2, "Size", Size.Small);
            builder.AddAttribute(3, "Class", "theme-selected");
            builder.AddAttribute(4, "aria-label", "Selected");
            builder.CloseComponent();
        }
    };
    protected override void OnInitialized() => ThemeState.Changed += Refresh;
    private Task SelectTheme(string preference) => ThemeState.SetPreferenceAsync(preference);
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => ThemeState.Changed -= Refresh;
}
