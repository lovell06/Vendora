@using Vendora.Web.Gateway
@inject UserSession Session
@inject NavigationManager Navigation

<div class="access-denied-container">
    <div class="access-denied-card">
        <div class="access-denied-icon">
            <MudIcon Icon="@Icons.Material.Outlined.LockPerson" Size="Size.Large" />
        </div>
        @if (Session.IsAuthenticated)
        {
            <h1 class="access-title">@L["Access denied"]</h1>
            <p class="access-desc">@L["You do not have permission to view this page. Go back to the store or contact your manager."]</p>
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="app-button">@L["Back to home"]</MudButton>
        }
        else
        {
            <h1 class="access-title">@L["Sign in required"]</h1>
            <p class="access-desc">@L["Sign in to your account to access this area."]</p>
            <MudButton Href="@LoginUrl" Variant="Variant.Filled" Color="Color.Primary" Class="app-button">@L["Sign in now"]</MudButton>
        }
    </div>
</div>

<style>
.access-denied-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: 32px 16px;
}
.access-denied-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 440px;
    width: 100%;
    padding: 40px 28px;
    border-radius: var(--shape-large);
    border: 1px solid var(--md-outline-variant);
    background: var(--md-surface-container-lowest);
    box-shadow: var(--shadow-card);
}
.access-denied-icon {
    width: 72px;
    height: 72px;
    border-radius: var(--shape-full);
    background: var(--md-primary-container);
    color: var(--md-primary);
    display: grid;
    place-items: center;
    margin-bottom: 20px;
}
.access-title {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 10px;
    color: var(--md-on-surface);
}
.access-desc {
    font-size: 0.9375rem;
    color: var(--md-on-surface-variant);
    margin: 0 0 24px;
    line-height: 1.5;
}
</style>

@code {
    private string LoginUrl =>
        "/login?returnUrl=" + Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
}
