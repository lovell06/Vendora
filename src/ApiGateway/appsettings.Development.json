{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:8080",
  "ReverseProxy":{
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "identity-openapi": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "catalog-products": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**remainder}"
        }
      },
      "catalog-categories": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**remainder}"
        }
      },
      "catalog-openapi": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/openapi/catalog.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "inventory-items": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory-items/{**remainder}"
        }
      },
      "inventory-openapi": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/openapi/inventory.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "cart-carts": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/carts/{**remainder}"
        }
      },
      "cart-openapi": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/openapi/cart.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "ordering-orders": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**remainder}"
        }
      },
      "ordering-openapi": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/openapi/ordering.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-1": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-1": {
            "Address": "http://catalog-api:8080/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-1": {
            "Address": "http://inventory-api:8080"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-1": {
            "Address": "http://cart-api:8080/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations":{
          "ordering-1": {
            "Address": "http://ordering-api:8080"
          }
        }
      }
    }
  }
}
